{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "simpletter",
  "version": "0.3.0",
  "identifier": "com.purewhite404.simpletter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "purewhite404",
    "copyright": "Copyright (c) 2026 purewhite404",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "simpletter.markdown",
        "description": "Markdown",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["csv", "tsv"],
        "name": "simpletter.table",
        "description": "CSV / TSV",
        "role": "Editor",
        "mimeType": "text/csv"
      }
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
