{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "simpletter",
  "version": "0.1.0",
  "identifier": "com.satoshi.simpletter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "simpletter.markdown",
        "description": "Markdown",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["csv", "tsv"],
        "name": "simpletter.table",
        "description": "CSV / TSV",
        "role": "Editor",
        "mimeType": "text/csv"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
